<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.staymateapp">

    <!-- 🔥 Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StayMateApp">

        <!-- 🔥 LAUNCHER ACTIVITY -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🔥 AUTH -->
        <activity android:name=".RegisterActivity" android:exported="false" />
        <activity android:name=".ChangePasswordActivity" android:exported="false" />

        <!-- 🔥 DASHBOARDS -->
        <activity android:name=".OwnerDashboardActivity" android:exported="false" />
        <activity android:name=".TenantDashboardActivity" android:exported="false" />

        <!-- 🔥 PROFILE -->
        <activity android:name=".OwnerProfileActivity" android:exported="false" />
        <activity android:name=".EditProfileActivity" android:exported="false" />

        <!-- 🔥 PROPERTY -->
        <activity android:name=".PropertyDetailsActivity" android:exported="false" />
        <activity android:name=".ActivityReviews" android:exported="false" />

        <!-- 🔥 ROOMMATE -->
        <activity android:name=".BrowseRoommatesActivity" android:exported="false" />
        <activity android:name=".CreateRoommateActivity" android:exported="false" />
        <activity android:name=".RoommateDetailsActivity" android:exported="false" />

        <!-- 🔥 CHAT -->
        <activity android:name=".ChatActivity" android:exported="false" />
        <activity android:name=".FullScreenImageActivity" android:exported="false" />

        <!-- 🔥 FIREBASE MESSAGING -->
        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>